# Copy to .env and start the API with:  uvicorn app.main:app --env-file .env
# Every value below is the default, so the file is optional for local work.

# Where the SQLite file lives.
DATABASE_URL=sqlite:///./parley.db

# Public address of the frontend. Invite links are built from it, and it is
# allowed to call the API (CORS).
FRONTEND_URL=http://localhost:3000

# Any other browser origins that may call the API, comma separated.
CORS_ORIGINS=http://127.0.0.1:3000

# Seconds an empty meeting waits before it is ended automatically.
EMPTY_ROOM_GRACE_SECONDS=15
